{
  "schemaVersion": 1,
  "id": "io.github.endboss.player",
  "name": "Endboss Player",
  "version": "0.1.0",
  "author": "endboss",
  "license": "MIT",
  "description": "Local music player for Omarchy, driven by the endbossd daemon.",
  "kinds": [
    "service",
    "bar-widget",
    "panel"
  ],
  "activation": "on-demand",
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Endboss Player",
    "description": "Local music library and player backed by endbossd.",
    "category": "Media",
    "aliases": [
      "music",
      "player",
      "endboss"
    ],
    "allowMultiple": false,
    "defaultSection": "left"
  }
}
